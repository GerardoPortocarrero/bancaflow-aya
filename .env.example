# Parámetros de Configuración de BancaFlow (Estructura de Producción / Desarrollo)
# Copia este archivo como '.env' e ingresa tus llaves correspondientes.

# Supabase (Base de Datos y Autenticación RLS)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Drive API (Cuenta de Servicio para Almacenamiento Masivo $0)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-shared-folder-id
